{"comment": "Adaptive Drive screen (acceptance test Q), shared by web/tests/dashboard.test.js and DashboardFocusTests.swift. Distances in miles. Order: a serious alert within 10 mi, fuel below the reserve, a serious alert within 50 mi, a planned stop, a gas gap, an alert within 10 mi, the state line within 5 mi, the fuel stop, the last open stop, overnight, a rest area, the next exit. Whatever the signals, the screen has one focus card and at most two strip items.",
 "cases": [
  {"name": "Normal driving: the next exit", "signals": {"nextExit": 3, "restArea": 40, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "exit", "strip": ["fuel", "restArea"]}},
  {"name": "No range entered yet: a prompt in the strip, not a card", "signals": {"nextExit": 3, "restArea": 40},
   "expect": {"focus": "exit", "strip": ["fuelEntry", "restArea"]}},
  {"name": "Approaching a planned stop", "signals": {"nextExit": 2, "plannedStop": 10, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "stop", "strip": ["fuel", "exit"]}},
  {"name": "Fuel below the reserve outranks everything", "signals": {"nextExit": 2, "plannedStop": 10, "fuel": {"range": 40, "reserve": 50, "stopAhead": 8}},
   "expect": {"focus": "fuel", "strip": ["stop", "exit"]}},
  {"name": "A stretch without gas the range may not cover", "signals": {"nextExit": 2, "gap": {"startsIn": 15, "length": 62}, "fuel": {"range": 90, "reserve": 50, "stopAhead": 10}},
   "expect": {"focus": "gap", "strip": ["fuel", "exit"]}},
  {"name": "The same stretch with plenty of range: a strip item", "signals": {"nextExit": 2, "gap": {"startsIn": 15, "length": 62}, "fuel": {"range": 300, "reserve": 50, "stopAhead": 190}},
   "expect": {"focus": "exit", "strip": ["gap"]}},
  {"name": "A gap with no range entered is a warning", "signals": {"nextExit": 2, "gap": {"startsIn": 0, "length": 70}},
   "expect": {"focus": "gap", "strip": ["fuelEntry", "exit"]}},
  {"name": "The fuel stop is near", "signals": {"nextExit": 2, "restArea": 30, "fuel": {"range": 120, "reserve": 50, "stopAhead": 20}},
   "expect": {"focus": "fuel", "strip": ["restArea", "exit"]}},
  {"name": "Overnight: open stops and restrooms take the focus", "signals": {"nextExit": 2, "restArea": 30, "overnight": true, "fuel": {"range": 250, "reserve": 50, "stopAhead": 160}},
   "expect": {"focus": "overnight", "strip": ["restArea", "exit"]}},
  {"name": "Overnight without a range: the restroom stop ahead", "signals": {"nextExit": 2, "restArea": 30, "overnight": true},
   "expect": {"focus": "overnight", "strip": ["fuelEntry", "restArea"]}},
  {"name": "A rest area before the next exit", "signals": {"nextExit": 8, "restArea": 4, "fuel": {"range": 250, "reserve": 50, "stopAhead": 160}},
   "expect": {"focus": "restArea", "strip": ["exit"]}},
  {"name": "Q. Everything at once: one focus, two strip items", "signals": {"nextExit": 6, "restArea": 4, "plannedStop": 9, "overnight": true, "gap": {"startsIn": 5, "length": 80}, "fuel": {"range": 45, "reserve": 50, "stopAhead": 7, "low": true}},
   "expect": {"focus": "fuel", "strip": ["gap", "stop"]}},
  {"name": "Overnight: the last stop listed open before a long stretch", "signals": {"nextExit": 2, "overnight": true, "lastOpen": 12, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "lastOpen", "strip": ["fuel", "exit"]}},
  {"name": "The last open stop still far: the overnight card", "signals": {"nextExit": 2, "overnight": true, "lastOpen": 40, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "overnight", "strip": ["exit"]}},
  {"name": "The fuel stop near outranks the last open stop", "signals": {"nextExit": 2, "overnight": true, "lastOpen": 12, "fuel": {"range": 200, "reserve": 50, "stopAhead": 20}},
   "expect": {"focus": "fuel", "strip": ["exit"]}},
  {"name": "A stretch without gas the range may not cover outranks the last open stop", "signals": {"nextExit": 2, "overnight": true, "lastOpen": 5, "gap": {"startsIn": 15, "length": 62}, "fuel": {"range": 90, "reserve": 50, "stopAhead": 10}},
   "expect": {"focus": "gap", "strip": ["fuel", "exit"]}},
  {"name": "A serious road alert outranks a planned stop", "signals": {"nextExit": 2, "plannedStop": 10, "alert": {"distance": 30, "serious": true}, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "alert", "strip": ["fuel", "stop"]}},
  {"name": "Fuel below the reserve comes before a serious alert more than 10 miles away", "signals": {"nextExit": 2, "alert": {"distance": 25, "serious": true}, "fuel": {"range": 40, "reserve": 50, "stopAhead": 8}},
   "expect": {"focus": "fuel", "strip": ["alert", "exit"]}},
  {"name": "A serious alert within 10 miles comes before fuel below the reserve", "signals": {"nextExit": 2, "alert": {"distance": 6, "serious": true}, "fuel": {"range": 40, "reserve": 50, "stopAhead": 8}},
   "expect": {"focus": "alert", "strip": ["fuel", "exit"]}},
  {"name": "A routine fuel stop never hides a serious alert just ahead", "signals": {"nextExit": 2, "alert": {"distance": 3, "serious": true}, "fuel": {"range": 200, "reserve": 50, "stopAhead": 4}},
   "expect": {"focus": "alert", "strip": ["fuel", "exit"]}},
  {"name": "Approaching the state line", "signals": {"nextExit": 2, "border": 3, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "border", "strip": ["fuel", "exit"]}},
  {"name": "The state line still far: the next exit", "signals": {"nextExit": 2, "border": 12, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "exit", "strip": ["fuel"]}},
  {"name": "A road alert just ahead comes before the state line", "signals": {"nextExit": 2, "border": 3, "alert": {"distance": 4, "serious": false}, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "alert", "strip": ["fuel", "exit"]}},
  {"name": "The state line comes before a routine fuel stop", "signals": {"nextExit": 2, "border": 3, "fuel": {"range": 200, "reserve": 50, "stopAhead": 20}},
   "expect": {"focus": "border", "strip": ["fuel", "exit"]}},
  {"name": "A minor alert takes the focus only when near", "signals": {"nextExit": 3, "alert": {"distance": 6, "serious": false}, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "alert", "strip": ["fuel", "exit"]}},
  {"name": "A minor alert farther away waits in the strip", "signals": {"nextExit": 3, "alert": {"distance": 25, "serious": false}, "fuel": {"range": 200, "reserve": 50, "stopAhead": 120}},
   "expect": {"focus": "exit", "strip": ["fuel", "alert"]}},
  {"name": "Nothing ahead on this road", "signals": {},
   "expect": {"focus": "none", "strip": ["fuelEntry"]}}
 ]}
