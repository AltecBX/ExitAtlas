{
  "about": "ExitAtlas design tokens: the single source for colors, type, spacing and radii on web and iOS. Run `node tools/design/build-tokens.mjs` to regenerate web/css/tokens.css and App/ExitAtlas/Design/Tokens.swift; web/tests/design.test.js fails when they are out of date or a text pair loses contrast.",
  "color": {
    "bg":            { "light": "#F2F3F5", "dark": "#07090D", "note": "Screen background: near black with a navy cast at night" },
    "card":          { "light": "#FFFFFF", "dark": "#11151C", "note": "Card surface" },
    "raised":        { "light": "#FFFFFF", "dark": "#171D27", "note": "Surfaces floating over the map (guidance, adaptive card, trip strip)" },
    "navy":          { "light": "#E9EEF6", "dark": "#0E1A2C", "note": "Navy surface: state line and trip strips" },
    "stroke":        { "light": "#DFE3E8", "dark": "#222934", "note": "Card and divider lines" },
    "text":          { "light": "#0E1116", "dark": "#F2F4F7", "note": "Primary text" },
    "text-2":        { "light": "#525C69", "dark": "#A3ACB7", "note": "Secondary text" },
    "chip":          { "light": "#ECEFF3", "dark": "#1A2029", "note": "Chips and inactive controls" },
    "accent":        { "light": "#1565D8", "dark": "#5B9BFF", "note": "Links and primary actions" },
    "amber":         { "light": "#8F5B00", "dark": "#F2A900", "note": "Caution text and approaching state line" },
    "amber-fill":    { "light": "#FFF4D6", "dark": "#2B2412", "note": "Caution background" },
    "danger":        { "light": "#C62828", "dark": "#FF6B6B", "note": "Over the limit, low fuel, urgent alerts" },
    "danger-fill":   { "light": "#FDECEC", "dark": "#2B1215", "note": "Urgent alert background" },
    "info":          { "light": "#1557B5", "dark": "#7DB3FF", "note": "Informational alerts (work zones with lanes open, minor notices)" },
    "info-fill":     { "light": "#E7F0FD", "dark": "#0F2036", "note": "Informational alert background" },
    "success":       { "light": "#0E7A43", "dark": "#3DD68C", "note": "Reachable, verified" },
    "success-fill":  { "light": "#E6F4EC", "dark": "#0D2318", "note": "Verified or recommended background" },
    "tint":          { "light": "#00673D", "dark": "#3DD68C", "note": "Selected tabs, switches and tinted buttons (sign green is too dark for text on dark cards)" },
    "sign-green":    { "light": "#00673D", "dark": "#0B7A4A", "note": "Guide sign green (exits, destinations); ink is white" },
    "sign-blue":     { "light": "#0B4DA2", "dark": "#1A5FC2", "note": "Service sign blue (gas, food, lodging, rest areas); ink is white" },
    "sign-brown":    { "light": "#6A3E1F", "dark": "#7D4A26", "note": "Recreation and cultural sign brown (parks, attractions); ink is white" },
    "sign-yellow":   { "light": "#FFC72C", "dark": "#FFC72C", "note": "Warning yellow; ink is black" },
    "sign-ink":      { "light": "#FFFFFF", "dark": "#FFFFFF", "note": "Text on green, blue and brown signs" },
    "sign-ink-dark": { "light": "#111111", "dark": "#111111", "note": "Text on yellow and white signs" },
    "shield-blue":   { "light": "#003F87", "dark": "#2E56B8", "note": "Interstate shield field" },
    "shield-red":    { "light": "#C8102E", "dark": "#E0293F", "note": "Interstate shield crown" },
    "seg0":          { "light": "#1D6FE0", "dark": "#4C93FF", "note": "Route color, state 1" },
    "seg1":          { "light": "#0E9F6E", "dark": "#2FC48D", "note": "Route color, state 2" },
    "seg2":          { "light": "#8E44AD", "dark": "#B57BDB", "note": "Route color, state 3" },
    "seg3":          { "light": "#D35400", "dark": "#F07F2B", "note": "Route color, state 4" },
    "map-land":      { "light": "#E6E9EE", "dark": "#1B2028", "note": "Map, states not on the route" },
    "map-land-on":   { "light": "#D9E8DD", "dark": "#1D2A22", "note": "Map, states on the route" },
    "map-line":      { "light": "#C3C9D2", "dark": "#333B46", "note": "Map, state borders" },
    "route":         { "light": "#1D6FE0", "dark": "#4C9BFF", "note": "The route ahead on the navigation map" },
    "route-casing":  { "light": "#FFFFFF", "dark": "#0A1F3D", "note": "Outline under the route line" },
    "route-passed":  { "light": "#A3ADBA", "dark": "#3A4352", "note": "The route already driven" },
    "map-bg":        { "light": "#EEF1F5", "dark": "#0B1017", "note": "Navigation map land" },
    "map-water":     { "light": "#C9D8EC", "dark": "#0A1626", "note": "Navigation map water" },
    "map-road":      { "light": "#FFFFFF", "dark": "#252D3A", "note": "Navigation map roads" },
    "map-motorway":  { "light": "#F2D8A7", "dark": "#38455C", "note": "Navigation map interstates and freeways" },
    "map-label":     { "light": "#5A6472", "dark": "#8792A2", "note": "Navigation map place and road names" }
  },
  "contrast": [
    { "fg": "text",          "bg": "card",        "min": 7.0 },
    { "fg": "text",          "bg": "bg",          "min": 7.0 },
    { "fg": "text-2",        "bg": "card",        "min": 4.5 },
    { "fg": "text-2",        "bg": "bg",          "min": 4.5 },
    { "fg": "accent",        "bg": "card",        "min": 4.5 },
    { "fg": "amber",         "bg": "card",        "min": 4.5 },
    { "fg": "amber",         "bg": "amber-fill",  "min": 4.5 },
    { "fg": "danger",        "bg": "card",        "min": 4.5 },
    { "fg": "success",       "bg": "card",        "min": 4.5 },
    { "fg": "tint",          "bg": "card",        "min": 4.5 },
    { "fg": "tint",          "bg": "bg",          "min": 4.5 },
    { "fg": "sign-ink",      "bg": "sign-green",  "min": 4.5 },
    { "fg": "sign-ink",      "bg": "sign-blue",   "min": 4.5 },
    { "fg": "sign-ink",      "bg": "sign-brown",  "min": 4.5 },
    { "fg": "sign-ink-dark", "bg": "sign-yellow", "min": 4.5 },
    { "fg": "sign-ink",      "bg": "shield-blue", "min": 4.5 },
    { "fg": "text",          "bg": "raised",      "min": 7.0 },
    { "fg": "text-2",        "bg": "raised",      "min": 4.5 },
    { "fg": "text",          "bg": "navy",        "min": 7.0 },
    { "fg": "text-2",        "bg": "navy",        "min": 4.5 },
    { "fg": "danger",        "bg": "danger-fill", "min": 4.5 },
    { "fg": "info",          "bg": "card",        "min": 4.5 },
    { "fg": "info",          "bg": "info-fill",   "min": 4.5 },
    { "fg": "success",       "bg": "success-fill","min": 4.5 },
    { "fg": "map-label",     "bg": "map-bg",      "min": 4.5 }
  ],
  "type": {
    "note": "Web sizes in px at the default text size; they scale with the reader's text size setting (rem, base 17 px). iOS uses the matching Dynamic Type styles. Nothing a driver needs is smaller than caption.",
    "speed":    { "px": 64, "weight": 800, "ios": "speed",      "note": "Speedometer digits" },
    "hero":     { "px": 44, "weight": 800, "ios": "largeTitle", "note": "Miles to the next state line, next exit distance" },
    "title-xl": { "px": 30, "weight": 800, "ios": "title",      "note": "Next state name" },
    "title-lg": { "px": 24, "weight": 800, "ios": "title2",     "note": "Card titles" },
    "title":    { "px": 20, "weight": 700, "ios": "title3",     "note": "Section titles" },
    "body":     { "px": 17, "weight": 400, "ios": "body",       "note": "Body text" },
    "callout":  { "px": 15, "weight": 500, "ios": "callout",    "note": "Secondary lines" },
    "caption":  { "px": 13, "weight": 600, "ios": "caption",    "note": "Labels and footnotes; the smallest size used" },
    "sign-font": "Overpass, a highway sign style typeface under the SIL Open Font License (bundled)"
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sign": 10, "chip": 999, "control": 14, "card": 20 }
}
